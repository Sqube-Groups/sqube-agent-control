{
  "name": "sqube-agent-guard",
  "version": "1.0.0",
  "readme": "README.md",
  "description": "Sqube Agent Control (Node.js): deterministic ALLOW/BLOCK/REQUIRE_APPROVAL policy, approvals, and tamper-evident execution ledger for AI agents (v1).",
  "homepage": "https://sqube-groups.github.io/sqube-agent-control/docs/intro",
  "bugs": {
    "url": "https://github.com/Sqube-Groups/sqube-agent-control/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/guard.test.js dist/contract.test.js dist/policyBundle.test.js dist/ledger.test.js dist/contractSemantics.test.js dist/executionEngine.test.js dist/deferredContract.test.js dist/otel.test.js dist/otelContract.test.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sqube-Groups/sqube-agent-control.git",
    "directory": "nodejs"
  },
  "keywords": [
    "sqube",
    "ai",
    "ai-agents",
    "agents",
    "agent-security",
    "execution",
    "authorization",
    "policy",
    "guardrail",
    "governance",
    "approval",
    "audit",
    "ledger"
  ]
}
