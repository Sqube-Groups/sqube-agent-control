# Copy to .env locally (never commit .env). Used by optional probe scripts only.
#
# In a .env file, quotes are optional (some loaders keep quotes in the value):
#   NVIDIA_API_KEY=nvapi-your-key-here
#   NVIDIA_API_KEY="nvapi-your-key-here"
#
# In your shell, use quotes around the value:
#   export NVIDIA_API_KEY="nvapi-your-key-here"
#
NVIDIA_API_KEY="nvapi-your-key-here"
